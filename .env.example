# Copy to .env for local dev (never committed — see .gitignore).
# On Vercel, set these in Project → Settings → Environment Variables instead.

# Required for passage generation + grading.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-4-6.
CLAUDE_MODEL=claude-sonnet-4-6

# Optional local dev server port. Defaults to 8787. (Ignored on Vercel.)
PORT=8787

# Optional. When set, the app requires this passphrase before it will call the
# API (so a public URL can't spend your Anthropic credit). Leave unset to allow
# open access. The user is prompted once and it's remembered in the browser.
# APP_PASSPHRASE=choose-something
