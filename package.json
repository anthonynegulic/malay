{
  "name": "bukit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/gen-icons.mjs",
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && npm run build:api && vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "check:seed": "node scripts/check-register-integrity.mjs",
    "verify:glosses": "node scripts/verify-example-glosses.mjs",
    "test": "tsx tests/p0.test.ts && tsx tests/scheduler.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/instrument-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@hono/node-server": "^1.13.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "ts-fsrs": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
